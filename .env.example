APP_NAME="Claritas Onboarding"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=claritas_onboarding
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
# Email Workflow capture sweeps run on the `database` queue (only that job; the
# app-wide default stays `sync`). retry_after MUST be larger than the job's
# 3600s timeout, or the queue re-reserves a long sweep while it is still running.
DB_QUEUE_RETRY_AFTER=7200
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hr@claritas.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Session (production: database + secure cookies) ────────────
SESSION_SECURE_COOKIE=false
# SESSION_DRIVER=database

# ── Security & Backup ─────────────────────────────────────────
FORCE_HTTPS=false
BACKUP_ENCRYPTION_KEY=
LOG_INTEGRITY_KEY=

# ── Threat Detection Thresholds ───────────────────────────────
SECURITY_LOGIN_FAIL_THRESHOLD=5
SECURITY_LOGIN_FAIL_WINDOW=600
SECURITY_RAPID_REQUEST_THRESHOLD=60
SECURITY_OFF_HOURS_START=22
SECURITY_OFF_HOURS_END=6
SECURITY_UPLOAD_RATE_LIMIT=10

# ADM-06 — SSO handoff to the KOL Management Portal. The secret MUST be
# byte-identical to SSO_SHARED_SECRET in that application's .env; a mismatch
# fails every handoff with a deliberately generic error on its side, so it
# will not tell you that is the cause. Leaving either blank hides the sidebar
# link and disables the route.
KOL_PORTAL_URL=
KOL_PORTAL_SHARED_SECRET=
